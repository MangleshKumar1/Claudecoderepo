# From Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# AI trip planner (server-side only; never prefix with NEXT_PUBLIC_)
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5. A cheaper option is claude-sonnet-5-5.
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional. AI plans each user may generate per 24 hours (default 10).
# AI_PLANS_PER_DAY=10

# Optional but recommended in production: a real map style (the default demo tiles are for development only)
# NEXT_PUBLIC_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY

# Photo uploads (Cloudflare R2). Everything for this app is named YORVIA, see docs/CLOUDFLARE_R2_SETUP.md
# Server-only secrets (never prefix with NEXT_PUBLIC_):
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=yorvia-media
# Public address the bucket's images are served from (custom domain recommended), no trailing slash:
NEXT_PUBLIC_MEDIA_BASE_URL=
# Optional. Photos each user may upload per 24 hours (default 30).
# UPLOADS_PER_DAY=30

# Google sign-in button on the login page. Set to true ONLY after enabling the Google provider in Supabase
# (Authentication -> Providers -> Google). See the README.
# NEXT_PUBLIC_GOOGLE_LOGIN=true

# Optional: affiliate id if you join Booking.com's affiliate programme (used on "Find stays" links)
# NEXT_PUBLIC_BOOKING_AID=

# Optional daily caps per user for the extra AI tools (defaults shown)
# AI_SEARCHES_PER_DAY=20
# AI_SUMMARIES_PER_DAY=20
# AI_IDENTIFY_PER_DAY=10
